<!DOCTYPE html>
<html lang="es">
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Ventas</title>
</head>
<body class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Ventas</h1>
            <p class="text-muted">Revisa el historial de ventas y crea nuevas ventas con detalle automático.</p>
        </div>
        <a href="/productos" class="btn btn-outline-primary">Ir a Productos</a>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card p-4">
                <h3 class="mb-3">Ventas registradas</h3>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Fecha</th>
                                <th>Total</th>
                                <th>Detalles</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (ventas.length === 0) { %>
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">No hay ventas registradas.</td>
                                </tr>
                            <% } %>
                            <% ventas.forEach(v => { %>
                                <tr>
                                    <td><%= v.id_venta %></td>
                                    <td><%= new Date(v.fecha).toLocaleString('es-ES') %></td>
                                    <td>$<%= Number(v.total).toFixed(2) %></td>
                                    <td><%= v.detalles_count %> artículos</td>
                                    <td>
                                        <a href="/ventas/<%= v.id_venta %>" class="btn btn-sm btn-primary">Ver</a>
                                        <form action="/ventas/delete/<%= v.id_venta %>" method="POST" class="d-inline-block">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card p-4">
                <h3 class="mb-3">Crear nueva venta</h3>
                <form action="/ventas/create" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Producto</label>
                        <select name="id_producto" class="form-select" required>
                            <option value="">Selecciona un producto</option>
                            <% productos.forEach(p => { %>
                                <option value="<%= p.id_producto %>"><%= p.nombre %> - $<%= Number(p.precio_unitario).toFixed(2) %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Cantidad</label>
                        <input type="number" name="cantidad" class="form-control" value="1" min="1" required>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Crear venta</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
