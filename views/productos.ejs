<!DOCTYPE html>
<html lang="es">
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>CRUD Ventas</title>
</head>
<body class="container mt-5">
    <h2>Gestión de Productos</h2>
    
    <form action="/productos/create" method="POST" enctype="multipart/form-data" class="mb-4 p-3 border">
        <input type="text" name="nombre" placeholder="Nombre Producto" class="form-control mb-2" required>
        <input type="number" step="0.01" name="precio_unitario" placeholder="Precio" class="form-control mb-2" required>
        <select name="id_categoria" class="form-control mb-2">
            <option value="1">Electrónica</option> </select>
        <input type="file" name="imagen" class="form-control mb-2">
        <button type="submit" class="btn btn-primary">Guardar Producto</button>
    </form>

    <table class="table">
        <thead>
            <tr>
                <th>Imagen</th>
                <th>Nombre</th>
                <th>Categoría</th>
                <th>Precio</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            <% productos.forEach(p => { %>
            <tr>
                <td><img src="/uploads/<%= p.imagen %>" width="50"></td>
                <td><%= p.nombre %></td>
                <td><%= p.categoria %></td>
                <td>$<%= p.precio_unitario %></td>
                <td>
                    <a href="/productos/delete/<%= p.id_producto %>" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
            <% }) %>
        </tbody>
    </table>
</body>
</html>